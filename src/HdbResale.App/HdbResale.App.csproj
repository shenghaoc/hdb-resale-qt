<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.1.0</Version>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>HDB Resale Explorer</Product>
    <Description>Independent HDB resale research desktop app for the HDB Resale Explorer API</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <QtBridgePackagePrefix>QtGroup.Qt.Bridge.CSharp</QtBridgePackagePrefix>
    <QtBridgeTemplateArch Condition="'$(QtBridgeTemplateArch)' == ''"
      >$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</QtBridgeTemplateArch>
    <QtBridgeTemplateArch Condition="'$(QtBridgeTemplateArch)' == 'X64'">x64</QtBridgeTemplateArch>
    <QtBridgeTemplateArch Condition="'$(QtBridgeTemplateArch)' == 'Arm64'">arm64</QtBridgeTemplateArch>
    <QtBridgeTemplateRid Condition="'$(QtBridgeTemplateRid)' == '' and '$(RuntimeIdentifier)' != ''"
      >$(RuntimeIdentifier)</QtBridgeTemplateRid>
    <QtBridgeTemplateRid Condition="'$(QtBridgeTemplateRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))"
      >win-$(QtBridgeTemplateArch)</QtBridgeTemplateRid>
    <QtBridgeTemplateRid Condition="'$(QtBridgeTemplateRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))"
      >linux-$(QtBridgeTemplateArch)</QtBridgeTemplateRid>
    <QtBridgeTemplateRid Condition="'$(QtBridgeTemplateRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))"
      >osx-$(QtBridgeTemplateArch)</QtBridgeTemplateRid>
    <QtBridgePackageId>$(QtBridgePackagePrefix).$(QtBridgeTemplateRid)</QtBridgePackageId>
    <!-- Linux uses its published release; macOS retains its separately verified pin. -->
    <QtBridgePackageVersion>0.4.0.22-beta</QtBridgePackageVersion>
    <QtBridgePackageVersion Condition="'$(QtBridgeTemplateRid)' == 'linux-x64'">0.4.0-beta</QtBridgePackageVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(QtBridgeTemplateRid)' == 'win-x64'
                    or '$(QtBridgeTemplateRid)' == 'win-arm64'
                    or '$(QtBridgeTemplateRid)' == 'linux-x64'
                    or '$(QtBridgeTemplateRid)' == 'osx-x64'
                    or '$(QtBridgeTemplateRid)' == 'osx-arm64'">
    <PackageReference Include="$(QtBridgePackageId)" Version="$(QtBridgePackageVersion)" />
  </ItemGroup>

  <Target Name="EnsureSupportedQtBridgePlatform" BeforeTargets="Restore;Build"
          Condition="'$(QtBridgeTemplateRid)' != 'win-x64'
                  and '$(QtBridgeTemplateRid)' != 'win-arm64'
                  and '$(QtBridgeTemplateRid)' != 'linux-x64'
                  and '$(QtBridgeTemplateRid)' != 'osx-x64'
                  and '$(QtBridgeTemplateRid)' != 'osx-arm64'">
    <Error Text="Qt Bridge for C# currently supports win-x64, win-arm64, linux-x64, osx-x64, and osx-arm64. Selected RID: '$(QtBridgeTemplateRid)'." />
  </Target>

  <ItemGroup>
    <Compile Include="AddressDetailState.cs" />
    <QtResource Include="assets/onemap-logo.png" Alias="hdb-resale/onemap-logo.png" />
    <None Include="Main.qml"/>
    <None Include="BuyerTrendChart.qml"/>
    <None Include="Theme.qml"/>
    <None Include="Section.qml"/>
    <None Include="FilterField.qml"/>
    <None Include="FilterBar.qml"/>
    <None Include="LoadStatus.qml"/>
    <None Include="KeyboardGate.qml"/>
    <Compile Include="Program.cs" />
    <Compile Include="ApiRequests.cs" />
    <Compile Include="BuyerPresentation.cs" />
    <Compile Include="BuyerTrend.cs" />
    <Compile Include="LegacyFactsJsonConverter.cs" />
    <Compile Include="BasemapConfiguration.cs" />
    <Compile Include="NativeTileStatus.cs" />
    <Compile Include="TileFailureStatus.cs" />
    <QtDotnetCMake Include="include(&quot;$(MSBuildProjectDirectory)/Native/TileStatus.cmake&quot;)" />
    <Compile Include="ResaleMapModel.cs" />
    <Compile Include="LocatedMapModel.cs" />
    <Compile Include="MapRowDiff.cs" />
    <Compile Include="MapPresentation.cs" />
    <Compile Include="UiMutationQueue.cs" />
    <ProjectReference Include="../HdbResale.Domain/HdbResale.Domain.csproj" />
  </ItemGroup>

  <!-- The bridge template emits an unbundled host. Stage its output into a
       development bundle so macOS and accessibility tools identify the app. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <HdbMacBundle>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/HdbResale.app</HdbMacBundle>
    <RunCommand>$(HdbMacBundle)/Contents/MacOS/HdbResale.App</RunCommand>
    <RunWorkingDirectory>$(HdbMacBundle)/Contents/MacOS</RunWorkingDirectory>
  </PropertyGroup>
  <Target Name="StageMacDevelopmentBundle" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ItemGroup><BundleFiles Include="$(TargetDir)**/*" /></ItemGroup>
    <Copy SourceFiles="@(BundleFiles)"
          DestinationFiles="@(BundleFiles->'$(HdbMacBundle)/Contents/MacOS/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="Info.plist" DestinationFolder="$(HdbMacBundle)/Contents" />
  </Target>
</Project>
