+// Isolated M10 measurement only. No synthetic completion or renderer changes.
+// SPDX-License-Identifier: BSD-2-Clause
+#pragma once
+
+#include <QtCore/QDebug>
+#include <QtCore/QObject>
+#include <QtCore/QThread>
+#include <QtCore/QVariantMap>
+
+#include <atomic>
+#include <chrono>
+
+namespace QMapLibre::M10Trace {
+inline bool enabled() {
+    static const bool value = qEnvironmentVariableIntValue("M10_MAPLIBRE_TRACE") != 0;
+    return value;
+}
+inline qint64 steadyNs() {
+    return static_cast<qint64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+inline void event(const QObject *map, const char *name, quint64 sequence = 0,
+                  const QString &source = {}, qint64 submittedBytes = -1,
+                  qint64 submittedFeatures = -1, int needsRepaint = -1,
+                  int placementChanged = -1) {
+    if (!enabled()) return;
+    const qint64 ns = steadyNs();
+    qInfo().noquote().nospace()
+        << "M10_MAPLIBRE event=" << name << " ns=" << ns
+        << " map=" << static_cast<const void *>(map)
+        << " thread=" << QThread::currentThreadId()
+        << " seq=" << sequence
+        << " source=" << source.toUtf8().toPercentEncoding()
+        << " submittedBytes=" << submittedBytes
+        << " submittedFeatures=" << submittedFeatures
+        << " needsRepaint=" << needsRepaint
+        << " placementChanged=" << placementChanged;
+}
+class SourceUpdateScope final {
+public:
+    SourceUpdateScope(const QObject *map, const QString &source, const QVariantMap &params)
+        : m_map(map), m_source(source), m_enabled(enabled()) {
+        if (!m_enabled) return;
+        static std::atomic<quint64> nextSequence{0};
+        m_sequence = nextSequence.fetch_add(1, std::memory_order_relaxed) + 1;
+        const QVariant data = params.value(QStringLiteral("data"));
+        // Do not parse serialized GeoJSON a second time for instrumentation.
+        // -1 means unknown, not zero. The host owns authoritative input counts.
+        if (data.metaType().id() == QMetaType::QByteArray) {
+            m_bytes = static_cast<qint64>(data.toByteArray().size());
+        } else if (data.metaType().id() == QMetaType::QVariantMap) {
+            const QVariant features = data.toMap().value(QStringLiteral("features"));
+            if (features.metaType().id() == QMetaType::QVariantList)
+                m_features = static_cast<qint64>(features.toList().size());
+        }
+        event(m_map, "source-update-enter", m_sequence, m_source, m_bytes, m_features);
+    }
+    ~SourceUpdateScope() {
+        if (m_enabled)
+            event(m_map, "source-update-return", m_sequence, m_source, m_bytes, m_features);
+    }
+    SourceUpdateScope(const SourceUpdateScope &) = delete;
+    SourceUpdateScope &operator=(const SourceUpdateScope &) = delete;
+private:
+    const QObject *m_map;
+    const QString &m_source;
+    bool m_enabled;
+    quint64 m_sequence{};
+    qint64 m_bytes{-1};
+    qint64 m_features{-1};
+};
+} // namespace QMapLibre::M10Trace
